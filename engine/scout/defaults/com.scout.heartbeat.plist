<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.scout.heartbeat.plist — runs the vault's scripts/heartbeat.sh every 30 min.

  Installed by `scoutctl schedule install-heartbeat-plist`, which fills the
  USER_HOME and SCOUT_DIR placeholders (spelled with surrounding double
  underscores in the values below) at install time. SCOUT_DIR is the
  bootstrapped vault. Mirrors the schedule-tick plist pattern.

  Never write the placeholder tokens verbatim in this comment: install-time
  substitution is a whole-file replace, and a substituted path containing a
  double hyphen is illegal inside an XML comment no matter how it is escaped.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.scout.heartbeat</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__SCOUT_DIR__/scripts/heartbeat.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__SCOUT_DIR__</string>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__USER_HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__USER_HOME__</string>
        <key>SCOUT_DATA_DIR</key>
        <string>__SCOUT_DIR__</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__SCOUT_DIR__/.scout-logs/launchd-heartbeat.log</string>
    <key>StandardErrorPath</key>
    <string>__SCOUT_DIR__/.scout-logs/launchd-heartbeat.log</string>
</dict>
</plist>
