<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.scout.heartbeat.plist — runs __SCOUT_DIR__/scripts/heartbeat.sh every 30 min.

  Installed by `scoutctl schedule install-heartbeat-plist`, which fills
  `__USER_HOME__` and `__SCOUT_DIR__` at install time. Mirrors the
  schedule-tick plist pattern.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.scout.heartbeat</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__SCOUT_DIR__/scripts/heartbeat.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__SCOUT_DIR__</string>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__USER_HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__USER_HOME__</string>
        <key>SCOUT_DATA_DIR</key>
        <string>__SCOUT_DIR__</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__SCOUT_DIR__/.scout-logs/launchd-heartbeat.log</string>
    <key>StandardErrorPath</key>
    <string>__SCOUT_DIR__/.scout-logs/launchd-heartbeat.log</string>
</dict>
</plist>
