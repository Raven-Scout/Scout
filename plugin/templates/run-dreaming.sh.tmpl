#!/bin/bash
# {{INSTANCE_NAME}} Dreaming runner — invoked by scheduler for evening + weekend sessions
# Processes feedback and does KB-only deep improvement work

set -euo pipefail

SCOUT_DIR="{{SCOUT_DIR}}"
# Exported so any consumer of scout-plugin's engine package resolves the vault.
export SCOUT_DATA_DIR="$SCOUT_DIR"
LOG_DIR="$SCOUT_DIR/.scout-logs"
CLAUDE_BIN="{{CLAUDE_BIN}}"
SCOUTCTL_BIN="{{SCOUTCTL_BIN}}"
TIMESTAMP=$(date +%Y-%m-%d_%H-%M)
LOG_FILE="$LOG_DIR/dreaming-$TIMESTAMP.log"
LOCK_FILE="$LOG_DIR/.scout-session.lock"

# Ensure log directory exists
mkdir -p "$LOG_DIR"

# Pin this run's timezone for every child — the shell helpers, the engine's
# Python hooks, the session itself — so they all date the run alike, even if
# the computer's zone changes mid-run. scripts/scout-tz.sh resolves it once,
# here on the host: scout-config.yaml's optional override, else the host's own
# zone. A warning (an override that names no real zone) goes to this run's log.
RUN_TZ="$("$SCOUT_DIR/scripts/scout-tz.sh" 2>>"$LOG_FILE" || true)"
if [ -n "$RUN_TZ" ]; then
    export SCOUT_USER_TIMEZONE="$RUN_TZ"
fi

# Concurrency guard — only one {{INSTANCE_NAME}} session at a time.
# scoutctl takes this same lock (bootstrap install|upgrade|resolve, connectors
# custom add|remove — engine/scout/scripts/bootstrap_lock.py), so this block
# follows its protocol (#331):
#   - The lock is created atomically. noclobber (`set -C`) opens it with
#     O_EXCL, so a runner never truncates a lock someone else holds.
#   - A lock is only ever removed for a dead (or reaped) PID, and only under
#     the O_EXCL <lock>.takeover guard, after re-reading the PID under it.
#     Everyone removing a lock not their own takes the guard first, and
#     nobody can create the lock while the old one occupies the path, so a
#     lock that still reads that PID under the guard is still the old one
#     when it is removed.
#   - An empty or unparseable lock is busy, never stale: it is a competitor
#     between its create and its PID write.
#   - On exit the lock is removed only while it still holds our PID.
# Liveness alone is not enough: a holder that is alive but not progressing
# (host slept mid-run, wedged network call) passes `kill -0` forever and
# would silently block every subsequent slot. Real sessions finish in
# minutes, so a holder past LOCK_MAX_AGE_SECS is wedged by definition —
# reap it and take over, and record the reap in failures.log so the
# takeover is visible to audit surfaces (not just this run's log).
LOCK_MAX_AGE_SECS="${SCOUT_LOCK_MAX_AGE_SECS:-7200}"   # 2h ceiling, env-overridable
LOCK_GUARD="$LOCK_FILE.takeover"
# A guard older than this was left by a process that died inside the guarded
# section; it is safe to clear. Matches bootstrap_lock._GUARD_ABANDONED_S.
LOCK_GUARD_ABANDONED_SECS=30

_scout_mtime() {
    # GNU stat first (errors on BSD), BSD stat second; nothing if unknown.
    stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || true
}

_scout_lock_pid() {
    # The PID in the lock; nothing if the lock is absent, empty or unparseable.
    local pid
    pid=$(tr -d ' \t\r\n' 2>/dev/null < "$LOCK_FILE") || return 0
    case "$pid" in
        ''|*[!0-9]*) ;;
        *) echo "$pid" ;;
    esac
}

_scout_pid_alive() {
    # PID 0 would make kill probe our own process group; it is never a holder.
    # ps catches a live holder under another uid, which kill -0 can't signal.
    [ "$1" -gt 0 ] 2>/dev/null && { kill -0 "$1" 2>/dev/null || ps -p "$1" >/dev/null 2>&1; }
}

_scout_take_guard() {
    local mtime
    if ( set -C; : > "$LOCK_GUARD" ) 2>/dev/null; then
        return 0
    fi
    # Someone else is recovering the lock. Step in only if they died doing it.
    mtime=$(_scout_mtime "$LOCK_GUARD")
    case "$mtime" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ $(( $(date +%s) - mtime )) -gt "$LOCK_GUARD_ABANDONED_SECS" ] || return 1
    rm -f "$LOCK_GUARD"
    ( set -C; : > "$LOCK_GUARD" ) 2>/dev/null
}

_scout_release_lock() {
    # If the lock was reaped and taken over while we ran, it is not ours to remove.
    if [ "$(_scout_lock_pid)" = "$$" ]; then
        rm -f "$LOCK_FILE"
    fi
}

LOCK_PID=""
LOCK_ACQUIRED=""
# Two attempts: recover a dead or wedged holder at most once, then retry the
# atomic create. Any other conflict means another session holds the lock.
for _lock_attempt in 1 2; do
    if ( set -C; echo $$ > "$LOCK_FILE" ) 2>/dev/null; then
        LOCK_ACQUIRED=1
        break
    fi
    LOCK_PID=$(_scout_lock_pid)
    if [ ! -e "$LOCK_FILE" ]; then
        continue   # the holder released between our create and our read
    fi
    if [ -z "$LOCK_PID" ] || [ "$_lock_attempt" = 2 ]; then
        break
    fi
    if _scout_pid_alive "$LOCK_PID"; then
        # Lock age = seconds since the holder wrote the lock at session start.
        # Sourced from the lock file's mtime: macOS ps has no `etimes` keyword,
        # so elapsed-seconds-of-PID is not portable. Unknown age → treat the
        # holder as fresh.
        LOCK_MTIME=$(_scout_mtime "$LOCK_FILE")
        LOCK_AGE=""
        case "$LOCK_MTIME" in
            ''|*[!0-9]*) ;;
            *) LOCK_AGE=$(( $(date +%s) - LOCK_MTIME )) ;;
        esac
        if [ -z "$LOCK_AGE" ] || [ "$LOCK_AGE" -le "$LOCK_MAX_AGE_SECS" ]; then
            break
        fi
        if ! _scout_take_guard; then
            break   # another process is already reaping or recovering it
        fi
        if [ "$(_scout_lock_pid)" = "$LOCK_PID" ]; then
            echo "=== Reaping wedged {{INSTANCE_NAME}} session (PID $LOCK_PID, lock held ${LOCK_AGE}s > ${LOCK_MAX_AGE_SECS}s) ===" >> "$LOG_FILE"
            echo "Reaped wedged session PID $LOCK_PID after ${LOCK_AGE}s at $(date)" >> "$LOG_DIR/failures.log"
            kill -TERM "$LOCK_PID" 2>/dev/null || true
            sleep 5
            # KILL before removing the lock: a KILLed holder cannot run its
            # EXIT trap. Re-read after it: during the grace the holder may
            # have released its lock and someone else taken the path.
            kill -KILL "$LOCK_PID" 2>/dev/null || true
            if [ "$(_scout_lock_pid)" = "$LOCK_PID" ]; then
                rm -f "$LOCK_FILE"
            fi
        fi
        rm -f "$LOCK_GUARD"
    else
        # Stale lock file — previous session crashed. Re-read under the guard:
        # another process that read the same dead PID may have taken over.
        if ! _scout_take_guard; then
            break   # another process is already recovering it
        fi
        if [ "$(_scout_lock_pid)" = "$LOCK_PID" ]; then
            rm -f "$LOCK_FILE"
        fi
        rm -f "$LOCK_GUARD"
    fi
done
if [ -z "$LOCK_ACQUIRED" ]; then
    echo "=== Another {{INSTANCE_NAME}} session running (PID ${LOCK_PID:-unknown}) — skipping ===" >> "$LOG_FILE"
    exit 0
fi
trap _scout_release_lock EXIT

# The prompt instructs Claude to read DREAMING.md and execute it
PROMPT="You are {{INSTANCE_NAME}} running in DREAMING mode — the evening self-improvement and KB deep work session. Your working directory is {{SCOUT_DIR}}.

Step 1: Read {{SCOUT_DIR}}/DREAMING.md in full.
Step 2: Execute Phase 1 (Feedback Processing) completely.
Step 3: Execute Phase 2 (KB Deep Work) completely.
Step 4: Execute Phase 3 (Wishlist) completely.
Step 5: Commit results to git.
Step 6: Send a brief Slack DM to {{USER_NAME}} (Slack ID: {{USER_SLACK_ID}}) summarizing feedback processed and KB work done.

Important:
- Use 'gh' CLI for all GitHub operations (not GitHub MCP).
- The knowledge base is in {{SCOUT_DIR}}/knowledge-base/.
- Always use [[wikilinks]] when referencing KB files.
- Commit with message format: dreaming [HH:MM]: <summary>
- Your output should focus on what you found and changed, not infrastructure steps."

echo "=== {{INSTANCE_NAME}} Dreaming run starting at $(date) ===" >> "$LOG_FILE"

# Pre-session hooks — gather data before Claude starts (saves tool calls inside the session).
# These write to .scout-cache/ for DREAMING.md to consume.
PRE_FILTER="$SCOUT_DIR/hooks/kb-pre-filter.sh"
if [ -x "$PRE_FILTER" ]; then
    "$PRE_FILTER" dreaming >> "$LOG_FILE" 2>&1 || true
fi
PRE_SESSION="$SCOUT_DIR/scripts/pre-session-data.sh"
if [ -x "$PRE_SESSION" ]; then
    "$PRE_SESSION" dreaming >> "$LOG_FILE" 2>&1 || true
fi
CC_CACHE="$SCOUT_DIR/scripts/cc-session-cache.sh"
if [ -x "$CC_CACHE" ]; then
    "$CC_CACHE" 24 >> "$LOG_FILE" 2>&1 || true
fi
# Daily-file completeness invariant — if today's action-items file doesn't
# exist yet, materialize it verbatim from the most recent daily file so no
# session (or app surface) ever sees a missing/stub list. No-op when present.
MATERIALIZE="$SCOUT_DIR/scripts/materialize-daily-file.sh"
if [ -x "$MATERIALIZE" ]; then
    "$MATERIALIZE" >> "$LOG_FILE" 2>&1 || true
fi

# Budget check — skip if we're over the spending threshold
BUDGET_CHECK="$SCOUT_DIR/scripts/budget-check.sh"
if [ -x "$BUDGET_CHECK" ]; then
    if ! "$BUDGET_CHECK" --verbose >> "$LOG_FILE" 2>&1; then
        echo "=== Budget check: skipping this run ===" >> "$LOG_FILE"
        exit 0
    fi
fi

# Mode is set by the dispatcher (SCOUT_FORCE_MODE). For manual invocations
# without SCOUT_FORCE_MODE set, default to "dreaming-manual".
MODE="${SCOUT_FORCE_MODE:-dreaming-manual}"
# Exported as SCOUT_MODE so the plugin's Stop hooks (session-tool-log,
# session-tokens — see hooks/hooks.json) see it inside the claude child
# process. When it is unset, session-tool-log deliberately writes nothing (so
# interactive sessions stay silent) and session-tokens labels the run `manual`;
# without this export every scheduled run looks interactive and no connector
# telemetry is ever written (#192, #121).
export SCOUT_MODE="$MODE"

START_TIME=$(date +%s)

# Run Claude in print mode through the retry wrapper — capture exit code without triggering set -e.
# Wrapper handles log redirection and retries on transient API errors (socket close,
# ECONNRESET, ConnectionRefused, Stream idle timeout, 529 Overloaded). See scripts/claude-with-retry.sh.
EXIT_CODE=0
cd "$SCOUT_DIR" && "$SCOUT_DIR/scripts/claude-with-retry.sh" \
    "$LOG_FILE" \
    "$CLAUDE_BIN" \
    --permission-mode auto \
    --model opus \
    --max-budget-usd {{MAX_BUDGET}} \
    --name "{{INSTANCE_NAME_LOWER}}-${MODE}-$(date +%Y%m%d-%H%M)" \
    -p "$PROMPT" \
    || EXIT_CODE=$?
END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

echo "=== {{INSTANCE_NAME}} Dreaming run finished at $(date) (exit code: $EXIT_CODE, duration: ${DURATION}s) ===" >> "$LOG_FILE"

# If the run failed, log it and check for rate limiting
if [ $EXIT_CODE -ne 0 ]; then
    echo "{{INSTANCE_NAME}} Dreaming run FAILED with exit code $EXIT_CODE at $(date)" >> "$LOG_DIR/failures.log"
    RATE_DETECT="$SCOUT_DIR/scripts/rate-limit-detect.sh"
    if [ -x "$RATE_DETECT" ]; then
        if "$RATE_DETECT" "$LOG_FILE" --write-tracker 2>/dev/null; then
            echo "Rate limit detected — logged to usage tracker" >> "$LOG_FILE"
        fi
    fi
fi

# Record how this run ended, out-of-band. This has to be a runner step, not a
# session step: the failure being watched for is a run that never reaches its
# phases (an expired login, a dead network), and nothing the session writes can
# report that. scripts/run-outcome.sh is an optional vault helper; a vault
# without it skips this step. Its errors go to the run log, so a broken helper
# (and with it the failure alerting) leaves a trace.
OUTCOME="$SCOUT_DIR/scripts/run-outcome.sh"
if [ -x "$OUTCOME" ]; then
    "$OUTCOME" record "$MODE" "$EXIT_CODE" "$START_TIME" "$LOG_FILE" >> "$LOG_FILE" 2>&1 || true
fi

# Regenerate the connector-health surface from the runner, for the same reason:
# a run that dies early has still logged its tool calls, but never refreshes
# knowledge-base/connector-health.md, which then goes stale while still looking
# current (showing alerts that later runs already resolved). The engine does the
# roll-up and says in this log when it had nothing to rewrite. Never fatal.
if [ -x "$SCOUTCTL_BIN" ]; then
    "$SCOUTCTL_BIN" connector-health-report >> "$LOG_FILE" 2>&1 || true
else
    echo "connector-health roll-up skipped: scoutctl not found at $SCOUTCTL_BIN" >> "$LOG_FILE"
fi

# Track session cost (skill self-reports actual cost from inside the session via the
# same script; this runner call is a fallback so failed/crashed runs still leave a row).
COST_TRACKER="$SCOUT_DIR/scripts/write-session-cost.sh"
if [ -x "$COST_TRACKER" ]; then
    "$COST_TRACKER" "dreaming" {{MAX_BUDGET}} 0 "$EXIT_CODE" "runner" 2>/dev/null || true
fi
