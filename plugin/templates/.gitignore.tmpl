.scout-logs/
.scout-cache/
.scout-state/last-assembled/
# Notifier bookkeeping (scoutctl health notify, scoutctl notify telegram): this
# host's push state and lock, not vault content.
.scout-state/health-notify.*
.scout-state/telegram-sent.jsonl*
# The inbound Telegram ledger (schedule tick, notify telegram --reply-to): the owner's
# messages and this host's poll offset, not vault content.
.scout-state/telegram-inbound/
# Agnes sync commit map, cached Local-Only list and pending-push note (scoutctl repo): this computer's state.
.scout-state/repo-sync.json
.scout-state/repo-sync-host.json
.scout-state/repo-sync-pending.json
.obsidian/
.DS_Store
__pycache__/
*.pyc
*.bak.*
*.proposed-merge

# Local Python environment for vault-side scripts
.venv/

# MCP server config — holds API keys. Sessions auto-commit the vault, so this
# line is what keeps a live key out of git history.
.mcp.json

# Dropped files for Scout to read (inbox/drop/): their contents stay out of git.
inbox/drop/*
!inbox/drop/README.md

# The layout move's journal and pre-move copies (scoutctl vault migrate): this computer's state.
.scout-state/migrations/
