#!/bin/bash
# {{INSTANCE_NAME}} Heartbeat — polls every 30 minutes to trigger extra sessions
# when budget is available and there's pending work.
#
# Designed to run via launchd every 30 minutes. Lightweight — exits quickly
# if conditions aren't met.
#
# Exit codes:
#   0 = checked (no action needed OR session launched)
#   1 = error
#
# Usage: heartbeat.sh [--dry-run]
#
# This is a thin wrapper around `scoutctl heartbeat run`. The bash version
# shelled out to python3 -c three times per tick just to walk the same tracker
# file three different ways. Folded into one Python process here (#74 + #79).

set -euo pipefail

SCOUTCTL_BIN="{{SCOUTCTL_BIN}}"
if [[ ! -x "$SCOUTCTL_BIN" ]]; then
    if command -v scoutctl >/dev/null 2>&1; then
        SCOUTCTL_BIN="$(command -v scoutctl)"
    else
        echo "heartbeat.sh: scoutctl not found (looked at ${SCOUTCTL_BIN})" >&2
        exit 1
    fi
fi

SCOUT_DATA_DIR="${SCOUT_DATA_DIR:-{{SCOUT_DIR}}}"
export SCOUT_DATA_DIR
export SCOUTCTL_BIN

DRY_RUN_FLAG=()
if [[ "${1:-}" == "--dry-run" ]]; then
    DRY_RUN_FLAG=("--dry-run")
fi

# Daily run-health sweep. run-outcome.sh calls `scoutctl health notify` after every
# run that reaches it, but a slot that never fires never calls run-outcome.sh, so
# nothing would push for it. The sweep catches that. `health notify` always exits
# 0; `|| true` keeps the heartbeat alive regardless. A date-stamped marker makes
# it run once a day, not on every tick.
if [[ ${#DRY_RUN_FLAG[@]} -eq 0 ]]; then
    _sweep_tz="$("$SCOUT_DATA_DIR/scripts/scout-tz.sh" 2>/dev/null || echo America/New_York)"
    _sweep_day="$(TZ="$_sweep_tz" date '+%Y-%m-%d')"
    _sweep_marker="$SCOUT_DATA_DIR/.scout-cache/health-sweep-${_sweep_day}.done"
    if [[ ! -f "$_sweep_marker" ]]; then
        mkdir -p "$SCOUT_DATA_DIR/.scout-cache" "$SCOUT_DATA_DIR/.scout-logs" 2>/dev/null || true
        "$SCOUTCTL_BIN" health notify --quiet \
            >>"$SCOUT_DATA_DIR/.scout-logs/health-notify.log" 2>&1 || true
        : >"$_sweep_marker" 2>/dev/null || true
        find "$SCOUT_DATA_DIR/.scout-cache" -name 'health-sweep-*.done' \
            -mtime +7 -delete 2>/dev/null || true
    fi
fi

exec "$SCOUTCTL_BIN" heartbeat run ${DRY_RUN_FLAG[@]+"${DRY_RUN_FLAG[@]}"}
