#!/bin/bash
# {{INSTANCE_NAME}} Heartbeat — polls every 30 minutes to trigger extra sessions
# when budget is available and there's pending work.
#
# Designed to run via launchd every 30 minutes. Lightweight — exits quickly
# if conditions aren't met.
#
# Exit codes:
#   0 = checked (no action needed OR session launched)
#   1 = error
#
# Usage: heartbeat.sh [--dry-run]
#
# This is a thin wrapper around `scoutctl heartbeat run`. The bash version
# shelled out to python3 -c three times per tick just to walk the same tracker
# file three different ways. Folded into one Python process here (#74 + #79).

set -euo pipefail

SCOUTCTL_BIN="{{SCOUTCTL_BIN}}"
if [[ ! -x "$SCOUTCTL_BIN" ]]; then
    if command -v scoutctl >/dev/null 2>&1; then
        SCOUTCTL_BIN="$(command -v scoutctl)"
    else
        echo "heartbeat.sh: scoutctl not found (looked at ${SCOUTCTL_BIN})" >&2
        exit 1
    fi
fi

SCOUT_DATA_DIR="${SCOUT_DATA_DIR:-{{SCOUT_DIR}}}"
export SCOUT_DATA_DIR
export SCOUTCTL_BIN

DRY_RUN_FLAG=()
if [[ "${1:-}" == "--dry-run" ]]; then
    DRY_RUN_FLAG=("--dry-run")
fi

# Session-lane liveness watchdog, once a day. Connector health watches tool
# calls inside a run, and the run-outcome record watches one run's exit; neither
# notices a whole session type (say, dreaming) quietly producing nothing for
# weeks. The optional vault helper scripts/session-lane-liveness.py does.
# --quiet prints only when a lane is unhealthy; it exits 2 (dark) or 3 (firing
# but silent), and `|| true` keeps a red lane from killing the heartbeat. A
# date-stamped marker makes it fire once a day, not on every tick.
if [[ ${#DRY_RUN_FLAG[@]} -eq 0 ]]; then
    _lane_tz="$("$SCOUT_DATA_DIR/scripts/scout-tz.sh" 2>/dev/null || echo America/New_York)"
    _lane_day="$(TZ="$_lane_tz" date '+%Y-%m-%d')"
    _lane_marker="$SCOUT_DATA_DIR/.scout-cache/lane-liveness-${_lane_day}.done"
    if [[ ! -f "$_lane_marker" ]] \
        && [[ -f "$SCOUT_DATA_DIR/scripts/session-lane-liveness.py" ]]; then
        mkdir -p "$SCOUT_DATA_DIR/.scout-cache" "$SCOUT_DATA_DIR/.scout-logs" 2>/dev/null || true
        python3 "$SCOUT_DATA_DIR/scripts/session-lane-liveness.py" --quiet --notify \
            >>"$SCOUT_DATA_DIR/.scout-logs/lane-liveness.log" 2>&1 || true
        : >"$_lane_marker" 2>/dev/null || true
        find "$SCOUT_DATA_DIR/.scout-cache" -name 'lane-liveness-*.done' \
            -mtime +7 -delete 2>/dev/null || true
    fi
fi

exec "$SCOUTCTL_BIN" heartbeat run ${DRY_RUN_FLAG[@]+"${DRY_RUN_FLAG[@]}"}
