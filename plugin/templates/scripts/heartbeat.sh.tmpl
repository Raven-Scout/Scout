#!/bin/bash
# {{INSTANCE_NAME}} Heartbeat — polls every 30 minutes to trigger extra sessions
# when budget is available and there's pending work.
#
# Designed to run via launchd every 30 minutes. Lightweight — exits quickly
# if conditions aren't met.
#
# Exit codes:
#   0 = checked (no action needed OR session launched)
#   1 = error
#
# Usage: heartbeat.sh [--dry-run]
#
# This is a thin wrapper around `scoutctl heartbeat run`. The bash version
# shelled out to python3 -c three times per tick just to walk the same tracker
# file three different ways. Folded into one Python process here (#74 + #79).

set -euo pipefail

SCOUTCTL_BIN="{{SCOUTCTL_BIN}}"
if [[ ! -x "$SCOUTCTL_BIN" ]]; then
    if command -v scoutctl >/dev/null 2>&1; then
        SCOUTCTL_BIN="$(command -v scoutctl)"
    else
        echo "heartbeat.sh: scoutctl not found (looked at ${SCOUTCTL_BIN})" >&2
        exit 1
    fi
fi

SCOUT_DATA_DIR="${SCOUT_DATA_DIR:-{{SCOUT_DIR}}}"
export SCOUT_DATA_DIR
export SCOUTCTL_BIN

DRY_RUN_FLAG=()
if [[ "${1:-}" == "--dry-run" ]]; then
    DRY_RUN_FLAG=("--dry-run")
fi

# Run-health sweep, on every tick. run-outcome.sh calls `scoutctl health notify`
# after every run that reaches it, but a slot that never fires never calls
# run-outcome.sh, so nothing would push for it. The sweep catches that. It runs
# every tick, not once a day: a finding that can be a wake artefact (a stalled
# scheduler) pushes only once a later evaluation still sees it, and notify is
# read-only and de-duplicated by its own state, so a repeat sweep never re-pushes.
# `health notify` always exits 0; `|| true` keeps the heartbeat alive regardless.
if [[ ${#DRY_RUN_FLAG[@]} -eq 0 ]]; then
    mkdir -p "$SCOUT_DATA_DIR/.scout-logs" 2>/dev/null || true
    "$SCOUTCTL_BIN" health notify --quiet \
        >>"$SCOUT_DATA_DIR/.scout-logs/health-notify.log" 2>&1 || true
    # Markers left by the old once-a-day sweep and lane script.
    find "$SCOUT_DATA_DIR/.scout-cache" \( -name 'health-sweep-*.done' -o -name 'lane-liveness-*.done' \) \
        -mtime +7 -delete 2>/dev/null || true

    # Headless engine update (#360), started at most once per local day. --detach
    # starts it in its own session and returns at once, so a fetch or venv build
    # never holds up this tick, and launchd doesn't kill it when this job exits
    # (a backgrounded `nohup … &` would stay in the job's process group and die).
    # `self-update run` decides everything else: it never touches an engine Scout.app
    # manages or a dev checkout, and writes the marker only once the day's attempt
    # is settled, so a deferred attempt (vault lock busy, a run due soon) retries
    # next tick. A lock keeps a second attempt from starting while one still runs.
    SU_DAY="$(date +%Y-%m-%d)"
    if [[ ! -e "$SCOUT_DATA_DIR/.scout-cache/self-update-$SU_DAY.done" ]]; then
        "$SCOUTCTL_BIN" self-update run --scheduled --detach \
            >>"$SCOUT_DATA_DIR/.scout-logs/self-update-$SU_DAY.log" 2>&1 </dev/null || true
    fi
    find "$SCOUT_DATA_DIR/.scout-cache" -name 'self-update-*.done' -mtime +7 -delete 2>/dev/null || true
    find "$SCOUT_DATA_DIR/.scout-logs" -name 'self-update-*.log' -mtime +30 -delete 2>/dev/null || true
fi

exec "$SCOUTCTL_BIN" heartbeat run ${DRY_RUN_FLAG[@]+"${DRY_RUN_FLAG[@]}"}
