#!/bin/bash
# claude-with-retry.sh — invoke `claude -p` with bounded retry for transient API errors.
#
# Retries on the network/API failure class that's killing long {{INSTANCE_NAME}} sessions:
#   - "socket connection was closed unexpectedly"  (undici UND_ERR_SOCKET)
#   - "Unable to connect to API (ECONNRESET)"
#   - "Unable to connect to API (ConnectionRefused)"
#   - "Stream idle timeout - partial response received"
#   - "Connection closed mid-response"             (socket torn down mid-stream,
#                                                    e.g. machine slept overnight)
#   - "went to sleep mid-response"                  (lid-close/clamshell sleep;
#                                                    idle sleep surfaces as the
#                                                    line above instead)
#   - "529 Overloaded"                              (Anthropic upstream temp)
#
# Does NOT retry on:
#   - 401 / 403 auth failures   (need user intervention)
#   - "Exceeded USD budget"     (intentional budget gate)
#   - Claude usage limits       ("You've hit your session limit · resets 6:50pm"):
#                                 they lift hours later, so a backoff of seconds would
#                                 retry into the same limit. scripts/rate-limit-detect.sh
#                                 records the reset and the budget gate holds later
#                                 slots until then (#407).
#   - Any non-zero exit whose log tail doesn't match the transient list
#
# IMPORTANT: each retry re-runs `claude -p` from scratch with the full prompt.
# That is safe only if the SKILL.md flow is idempotent — i.e. mid-run commits
# leave a recoverable state and a fresh invocation will not double-commit.
# The {{INSTANCE_NAME}} dreaming/consolidation/research modes are *documented*
# as restartable, but verify in a dry run before relying on this in production.
#
# Usage:
#   claude-with-retry.sh <log-file> <claude-bin> <claude-args...>
#
# Env knobs:
#   SCOUT_RETRY_MAX=2          total attempts (default: 2 → 1 retry)
#   SCOUT_RETRY_BACKOFF_S=60   base backoff seconds (default 60; scales linearly: 60s, 120s, ...)
#   SCOUT_RETRY_DISABLE=1      single-attempt mode (legacy behavior)
#   SCOUT_AUTH_ALERT_INTERVAL_S=86400
#                              minimum seconds between auth-failure desktop
#                              notifications (default: one a day)
#   SCOUT_NO_CAFFEINATE=1      hold no idle-sleep assertion (see POWER below)
#
# Exit code: the exit code of the final attempt.

set -euo pipefail

if [ "$#" -lt 2 ]; then
    echo "usage: $0 <log-file> <claude-bin> <claude-args...>" >&2
    exit 2
fi

LOG_FILE="$1"; shift
CLAUDE_BIN="$1"; shift

MAX_ATTEMPTS="${SCOUT_RETRY_MAX:-2}"
BACKOFF_S="${SCOUT_RETRY_BACKOFF_S:-60}"
if [ "${SCOUT_RETRY_DISABLE:-0}" = "1" ]; then
    MAX_ATTEMPTS=1
fi

# Pipe-separated grep -E regex. Keep narrow — anything matched here triggers a retry.
#
# `Can.t reach the API server` / `(ENOTFOUND)` is the DNS-resolution failure, added
# 2026-10-18. The list already held its two siblings — ECONNRESET and
# ConnectionRefused — but not the one that fires when the name never resolves at all
# (Wi-Fi handoff, VPN flap, waking from sleep), and the CLI words that one as a whole
# different sentence: `API Error: Can't reach the API server — check your internet or
# DNS (ENOTFOUND)`. Measured over this vault's logs: 8 runs hit it, **7 died
# unretried**, the last being the Sunday 2026-10-18 weekend briefing — 2 h 3 m of
# runtime, no board, no DM, and `run-outcome.sh` filed it `failure_class: network`
# while the retry gate called it permanent. The apostrophe is `.` on purpose: this
# string is single-quoted. Known remaining gap, unevidenced here so deliberately not
# added: `EAI_AGAIN` (DNS timeout) would be the same class.
TRANSIENT_PATTERNS='socket connection was closed unexpectedly|Unable to connect to API \(ECONNRESET\)|Unable to connect to API \(ConnectionRefused\)|Unable to connect to API \(ENOTFOUND\)|Can.t reach the API server|Stream idle timeout|Connection closed mid-response|went to sleep mid-response|529 Overloaded'

# Auth-failure class (HTTP 401/403). NOT retried — re-authentication needs a human —
# but surfaced with a concrete remediation instead of the opaque "not classified"
# line, since a rejected credential blocks EVERY scheduled run until fixed.
# The Claude CLI's own phrasing, at the start of a line, so output that merely
# quotes an auth error (or another service's 403) doesn't count. Same string as
# run-outcome.sh's AUTH_RE and bootstrap_doctor.CLI_AUTH_FAILURE_ERE; a test keeps
# the three equal.
AUTH_PATTERNS='^(Failed to authenticate([.:]|$)|Invalid authentication credentials|API Error: 40[13]|OAuth (session|token)( has)? expired|Not logged in)'

# Claude Code's quota message names its own reset. Same anchor as
# rate-limit-detect.sh and run-outcome.sh use for it.
USAGE_LIMIT_PATTERN='limit.{0,20}resets'

# The one command that fixes an expired login. A bare `claude` opens a session
# that still needs /login; this goes straight to the sign-in.
AUTH_FIX="claude auth login"

# Headless login (#267): the long-lived `claude setup-token` token that
# `scoutctl auth setup-token` stores outside the vault (the login Keychain on
# macOS, a 0600 file elsewhere), exported for every run so scheduled runs outlive
# the interactive login. A CLAUDE_CODE_OAUTH_TOKEN already in the environment
# wins; no stored token, or a Keychain that won't hand it over (locked), leaves
# the login in charge. The token is never echoed or logged. Keep the store in
# step with scout.claude_auth.default_store.
TOKEN_FILE="${HOME:+$HOME/.config/scout/claude-oauth-token}"
KEYCHAIN_SERVICE="scout-claude-oauth-token"
TOKEN_SOURCE=""       # environment | keychain | file; empty: the interactive login
TOKEN_STORE=""        # where a stored token lives, for the banner
TOKEN_UNREADABLE=0    # a stored token exists but couldn't be read
if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
    TOKEN_SOURCE="environment"
elif [ "$(uname -s 2>/dev/null || true)" = "Darwin" ]; then
    TOKEN_STORE="the macOS Keychain (item $KEYCHAIN_SERVICE)"
    keychain_rc=0
    stored_token="$(security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$(id -un)" -w 2>/dev/null)" || keychain_rc=$?
    if [ "$keychain_rc" -eq 0 ] && [ -n "$stored_token" ]; then
        export CLAUDE_CODE_OAUTH_TOKEN="$stored_token"
        TOKEN_SOURCE="keychain"
    elif [ "$keychain_rc" -ne 0 ] && [ "$keychain_rc" -ne 44 ]; then
        # 44 is "no such item". Anything else: the item may be there, but the
        # Keychain is locked or refused this process.
        TOKEN_UNREADABLE=1
        echo "=== Claude sign-in: couldn't read the stored token from $TOKEN_STORE (security exit $keychain_rc; is the Keychain locked?) — using the interactive login ===" >> "$LOG_FILE"
    fi
    unset stored_token keychain_rc
elif [ -n "$TOKEN_FILE" ] && [ -e "$TOKEN_FILE" ]; then
    TOKEN_STORE="$TOKEN_FILE"
    if [ -r "$TOKEN_FILE" ]; then
        stored_token="$(tr -d '[:space:]' < "$TOKEN_FILE" 2>/dev/null || true)"
        if [ -n "$stored_token" ]; then
            export CLAUDE_CODE_OAUTH_TOKEN="$stored_token"
            TOKEN_SOURCE="file"
        fi
        unset stored_token
    else
        TOKEN_UNREADABLE=1
        echo "=== Claude sign-in: can't read $TOKEN_FILE — using the interactive login ===" >> "$LOG_FILE"
    fi
fi
# With a token exported, `claude auth login` can't fix a rejection: the token
# overrides the login.
case "$TOKEN_SOURCE" in keychain|file) AUTH_FIX="scoutctl auth setup-token" ;; esac
# How this run signed in, for `scoutctl bootstrap doctor` / `scoutctl health`.
# Best-effort, and never the token.
printf '{"at": %s, "source": "%s", "token_unreadable": %s}\n' \
    "$(date +%s)" "${TOKEN_SOURCE:-login}" "$([ "$TOKEN_UNREADABLE" -eq 1 ] && echo true || echo false)" \
    > "$(dirname "$LOG_FILE")/.claude-sign-in.json" 2>/dev/null || true

# The auth banner lands in the session log, which nobody reads while scheduled
# runs fail for weeks — so an auth failure also raises a desktop notification.
# Local on purpose: osascript / notify-send work without the rejected credential,
# unlike anything routed through Claude or a connector. The marker sits next to
# the run logs and holds the epoch of the last alert; a successful run removes it,
# so the next expiry alerts straight away.
AUTH_ALERT_INTERVAL_S="${SCOUT_AUTH_ALERT_INTERVAL_S:-86400}"
case "$AUTH_ALERT_INTERVAL_S" in ''|*[!0-9]*) AUTH_ALERT_INTERVAL_S=86400 ;; esac
AUTH_ALERT_MARKER="$(dirname "$LOG_FILE")/.auth-alert-sent"

# Best-effort: never changes the wrapper's exit code.
notify_auth_failure() {
    local now last=0 sent=0
    local title="{{INSTANCE_NAME}} can't run"
    local body="Your Claude login expired. Open Terminal and run: $AUTH_FIX"
    case "$TOKEN_SOURCE" in
        keychain|file) body="Your stored Claude token was rejected. Open Terminal and run: $AUTH_FIX" ;;
    esac
    now="$(date +%s)"
    if [ -f "$AUTH_ALERT_MARKER" ]; then
        last="$(cat "$AUTH_ALERT_MARKER" 2>/dev/null || true)"
        case "$last" in ''|*[!0-9]*) last=0 ;; esac
    fi
    # 10#: a value with a leading zero is decimal, not (invalid) octal.
    if [ $(( 10#$now - 10#$last )) -lt $(( 10#$AUTH_ALERT_INTERVAL_S )) ]; then
        echo "    Desktop notification suppressed (one was sent in the last ${AUTH_ALERT_INTERVAL_S}s)." >> "$LOG_FILE"
        return 0
    fi
    # Claim the slot before notifying. Without a marker there is no rate limit,
    # so if it can't be written, skip rather than alert on every scheduler tick.
    if ! { echo "$now" > "$AUTH_ALERT_MARKER"; } 2>/dev/null; then
        echo "    No desktop notification: can't write the rate-limit marker $AUTH_ALERT_MARKER." >> "$LOG_FILE"
        return 0
    fi
    if command -v osascript >/dev/null 2>&1; then
        # Title and body go in as argv, never into the AppleScript source.
        printf '%s\n' 'on run argv' \
            '    display notification (item 2 of argv) with title (item 1 of argv) sound name "Basso"' \
            'end run' \
            | osascript - "$title" "$body" >/dev/null 2>&1 && sent=1
    elif command -v notify-send >/dev/null 2>&1; then
        # cron runs without the desktop session's bus address; point at the user bus when there is one.
        [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "/run/user/$(id -u)/bus" ] && DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus" && export DBUS_SESSION_BUS_ADDRESS
        notify-send --urgency=critical "$title" "$body" >/dev/null 2>&1 && sent=1
    fi
    if [ "$sent" -eq 1 ]; then
        echo "    Desktop notification sent." >> "$LOG_FILE"
    else
        # Release the slot so the next run tries again.
        rm -f "$AUTH_ALERT_MARKER" 2>/dev/null || true
        echo "    No desktop notification: osascript / notify-send missing or failed." >> "$LOG_FILE"
    fi
}

# Idle-sleep assertion (#210). An unattended host idle-sleeps mid-run, the
# streaming response dies with it, and the run fails with what reads as an API
# error. Every attempt AND every backoff sleep runs under the assertion: the
# backoff is the one moment the wrapper is deliberately idle, so wrapping only
# the attempt leaves the more exposed line bare. macOS: caffeinate (-i idle,
# -m disk, -s system sleep on AC). Linux: systemd-inhibit, when it can actually
# take the lock here (cron often has no logind session). Neither → no-op. A lid
# close still sleeps the machine; this only stops idle sleep.
POWER=()
if [ "${SCOUT_NO_CAFFEINATE:-0}" != "1" ]; then
    if command -v caffeinate >/dev/null 2>&1 && caffeinate -i -m -s true >/dev/null 2>&1; then
        POWER=(caffeinate -i -m -s)
    elif command -v systemd-inhibit >/dev/null 2>&1 \
        && systemd-inhibit --what=idle:sleep --why="{{INSTANCE_NAME}} run" true >/dev/null 2>&1; then
        POWER=(systemd-inhibit --what=idle:sleep --why="{{INSTANCE_NAME}} run")
    fi
fi

# Byte size of the run log, so each attempt is classified on its own output only.
log_size() {
    local n=0
    if [ -f "$LOG_FILE" ]; then
        n="$(wc -c < "$LOG_FILE" 2>/dev/null | tr -d ' ' || true)"
    fi
    case "$n" in ''|*[!0-9]*) n=0 ;; esac
    echo "$n"
}

attempt=1
exit_code=0
while :; do
    if [ "$attempt" -gt 1 ]; then
        echo "=== Claude retry attempt $attempt/$MAX_ATTEMPTS at $(date) ===" >> "$LOG_FILE"
    fi

    # Where this attempt's output starts. The log also holds the pre-session hooks'
    # output and every earlier attempt; classifying those let attempt 1's transient
    # error hide an auth failure on the retry, and let hook output that quotes an
    # HTTP status pass for a rejected login.
    attempt_start="$(log_size)"
    exit_code=0
    # ${POWER[@]+…}: bash 3.2 (macOS /bin/bash) calls an empty array unbound under set -u.
    ${POWER[@]+"${POWER[@]}"} "$CLAUDE_BIN" "$@" >> "$LOG_FILE" 2>&1 || exit_code=$?

    if [ "$exit_code" -eq 0 ]; then
        rm -f "$AUTH_ALERT_MARKER" 2>/dev/null || true
        exit 0
    fi

    # Snapshot this attempt's tail once, then match against the variable.
    # `tail … | grep -q` SIGPIPEs the writer (141) as soon as grep matches, and
    # `pipefail` makes 141 the pipeline's status — which would silently reclassify a
    # transient failure as "not transient" and skip the retry this wrapper exists
    # for. (The inner `tail -n 50` reads all of its input, so it never SIGPIPEs the
    # `tail -c`.) `|| true` keeps an unreadable log from aborting the wrapper under
    # `set -e`, so the real claude exit code still reaches the caller.
    ATTEMPT_TAIL="$(tail -c +$(( 10#$attempt_start + 1 )) "$LOG_FILE" 2>/dev/null | tail -n 50 || true)"
    is_transient=0
    grep -qE "$TRANSIENT_PATTERNS" <<<"$ATTEMPT_TAIL" && is_transient=1

    # Auth is classified before the attempts check: single-attempt mode, or a
    # retry that dies on auth, must still get the banner and the notification.
    if [ "$is_transient" -eq 0 ] && grep -qE "$AUTH_PATTERNS" <<<"$ATTEMPT_TAIL"; then
        {
            echo "=== Authentication failure (HTTP 401/403) — no retry (exit $exit_code) ==="
            echo "    Claude Code's API credentials were rejected. This blocks every scheduled {{INSTANCE_NAME}} run until re-authenticated."
            case "$TOKEN_SOURCE" in
                keychain|file)
                    echo "    The stored long-lived token in $TOKEN_STORE was rejected: it expired or was revoked."
                    echo "      - run: scoutctl auth setup-token   to store a new one, or"
                    echo "      - run: scoutctl auth clear         to go back to your interactive Claude login."
                    ;;
                environment)
                    echo "    CLAUDE_CODE_OAUTH_TOKEN from this runner's environment was rejected: replace it where it is set,"
                    echo "    or unset it and run: scoutctl auth setup-token"
                    ;;
                *)
                    if [ "$TOKEN_UNREADABLE" -eq 1 ]; then
                        echo "    A long-lived token is stored in $TOKEN_STORE, but this run couldn't read it, so it used your login."
                    fi
                    echo "    Re-authenticate the claude binary this runner uses ($CLAUDE_BIN):"
                    echo "      - interactive: run: $AUTH_FIX   (or: $CLAUDE_BIN auth login), or"
                    echo "      - headless:    run: scoutctl auth setup-token   (stores a long-lived 'claude setup-token' token every scheduled run uses)."
                    ;;
            esac
            echo "    Then verify before the next scheduled run:  $CLAUDE_BIN -p 'hello' --model ${SCOUT_MODEL:-opus}"
        } >> "$LOG_FILE"
        notify_auth_failure || true
        exit "$exit_code"
    fi

    # Not retried, whatever the attempts left: see the header. Named, so the log
    # says why instead of "not classified".
    if [ "$is_transient" -eq 0 ] \
        && limit_line="$(grep -iE "$USAGE_LIMIT_PATTERN" <<<"$ATTEMPT_TAIL" | tail -n 1)" \
        && [ -n "$limit_line" ]; then
        {
            echo "=== Claude usage limit — no retry (exit $exit_code) ==="
            echo "    $limit_line"
            echo "    The next scheduled run after the reset picks up."
        } >> "$LOG_FILE"
        exit "$exit_code"
    fi

    if [ "$attempt" -ge "$MAX_ATTEMPTS" ]; then
        echo "=== Retry exhausted: $MAX_ATTEMPTS attempts, last exit $exit_code ===" >> "$LOG_FILE"
        exit "$exit_code"
    fi

    if [ "$is_transient" -eq 0 ]; then
        echo "=== Failure not classified as transient — no retry (exit $exit_code) ===" >> "$LOG_FILE"
        exit "$exit_code"
    fi

    sleep_s=$(( BACKOFF_S * attempt ))
    echo "=== Transient API error detected — sleeping ${sleep_s}s before retry ===" >> "$LOG_FILE"
    slept_from="$(date +%s)"
    ${POWER[@]+"${POWER[@]}"} sleep "$sleep_s"
    # The elapsed time, not just the intent: a host that slept through the
    # backoff anyway (lid closed) shows up here as hours, not as "${sleep_s}s".
    echo "=== Backoff done after $(( $(date +%s) - slept_from ))s ===" >> "$LOG_FILE"
    attempt=$(( attempt + 1 ))
done
