#!/usr/bin/env bash
#
# run-outcome.sh — record how a scheduled {{INSTANCE_NAME}} run ended, and hand the
# ledger to the run-health notifier.
#
# This has to run from the runner, not from inside the session: the failure it
# exists to catch is a run that never reaches its phases (an expired login, a
# dead network). Every in-session signal is blind to that:
#   .scout-state/last-fire.json  records that a slot was dispatched, not how it ended
#   connector-health.md          rolls up tool calls; a run that dies at startup
#                                makes none, which looks like a quiet window
#   the wrap-up message          is composed by the run itself
# So the watcher is still the wrapper. After every run (a success too, so a
# recovery is noticed) it calls `scoutctl health notify`, which decides what is
# red and pushes to every configured channel. If scoutctl itself cannot run, the
# wrapper raises one local desktop alert (at most a day apart): the floor.
#
# Usage (from each run-*.sh, after the session):
#     scripts/run-outcome.sh record <mode> <exit_code> <started_epoch> <log_file> [<outcome>]
#     scripts/run-outcome.sh clear-stale-locks
#
# <outcome> is given only for a deliberate skip (#401): skipped_lock (another
# session held the vault lock), skipped_budget (the budget check said no),
# skipped_redundant, or a Repository Writer Lease skip of a vault linked to
# Agnes (R2): lease_held (Agnes holds the lease) or lease_unavailable (Agnes
# couldn't grant it). A lease skip is recorded as outcome skipped_lease with the
# reason as its failure_class. A runner records its skip before it exits, so a fired slot
# always leaves a row and `scoutctl health` can tell "fired and skipped" from
# "fired and vanished". Anything else is ignored, and the row's outcome is ok or
# failed from the exit code. An older helper ignores the extra argument.
#
# Each row also says which runner wrote it (`runner`, from SCOUT_RUNNER_KIND, which
# scripts/scout-lock.sh reads to spot a redundant run), what started it
# (`trigger`), and how many commits landed in the run's window
# (`commits_in_window`, `newest_commit`; #237). The commit count is measured,
# never assumed: when it can't be (no git, no repo, an implausible start), both
# are null, never 0. A window is observable; authorship is not, so health text
# says "in this run's window", never "by this run".
#
# Ledger: .scout-logs/run-outcomes.jsonl (gitignored; one JSON object per run).
# Never fails the run: every path of `record` exits 0.

set -uo pipefail

SCOUT_DIR="${SCOUT_DATA_DIR:-{{SCOUT_DIR}}}"
LOG_DIR="$SCOUT_DIR/.scout-logs"
LEDGER="$LOG_DIR/run-outcomes.jsonl"
SCOUTCTL="${SCOUTCTL_BIN:-{{SCOUTCTL_BIN}}}"
if [ ! -x "$SCOUTCTL" ]; then
    SCOUTCTL="$(command -v scoutctl 2>/dev/null || true)"
fi

# The engine-unreachable floor: one desktop alert, rate-limited by this marker
# (it holds an epoch). A working `health notify` removes it.
ENGINE_ALERT_MARKER="$LOG_DIR/.engine-alert-sent"
ENGINE_ALERT_INTERVAL_S="${SCOUT_ENGINE_ALERT_INTERVAL_S:-86400}"
case "$ENGINE_ALERT_INTERVAL_S" in ''|*[!0-9]*) ENGINE_ALERT_INTERVAL_S=86400 ;; esac

# Log patterns per failure class, matched case-insensitively against the tail of
# the run's log. Kept narrow on purpose: the log also holds the pre-session
# steps' output, and the budget check's preamble names the budget on every run.
# AUTH_RE is the Claude CLI's own phrasing at the start of a line, matched
# case-sensitively; it is the same string as the retry wrapper's AUTH_PATTERNS and
# bootstrap_doctor.CLI_AUTH_FAILURE_ERE (a test keeps them equal), so the ledger
# class, the desktop alert and the doctor agree on what a rejected login is.
AUTH_RE='^(Failed to authenticate([.:]|$)|Invalid authentication credentials|API Error: 40[13]|OAuth (session|token)( has)? expired|Not logged in)'
NETWORK_RE='ENOTFOUND|ECONNRESET|ECONNREFUSED|ConnectionRefused|ETIMEDOUT|socket hang up|socket connection was closed unexpectedly|Stream idle timeout|Connection closed mid-response'
GIT_LOCK_RE='index\.lock|HEAD\.lock'
# Keep in sync with PATTERNS in scripts/rate-limit-detect.sh: that one decides whether to
# retry, this one labels the failure. Claude Code's own quota message ("You've hit your
# session limit · resets <time>") matched neither, so those runs were never retried and
# were labelled `unknown`. `limit.{0,20}resets` keys on the self-declared reset rather than
# the wording, so a rewording ("weekly limit", "5-hour limit") still matches.
RATE_LIMIT_RE='rate.?limit|too many requests|API Error: 429|overloaded|usage limit|session limit|hit your .{0,20}limit|limit.{0,20}resets'
BUDGET_RE='Exceeded USD budget'

# classify_failure <log_file> <exit_code> — name the failure class, so a streak
# of failures reads as "three auth expiries and a network blip" rather than
# "four runs produced nothing".
classify_failure() {
    local log="$1" code="$2" tail_txt
    [ "$code" -eq 0 ] && { echo "ok"; return; }
    [ -f "$log" ] || { echo "unknown"; return; }
    tail_txt="$(tail -c 20000 "$log" 2>/dev/null || true)"
    if grep -qE "$AUTH_RE" <<<"$tail_txt"; then echo "oauth_expired"
    elif grep -qiE "$NETWORK_RE" <<<"$tail_txt"; then echo "network"
    elif grep -qiE "$GIT_LOCK_RE" <<<"$tail_txt"; then echo "git_lock"
    elif grep -qiE "$RATE_LIMIT_RE" <<<"$tail_txt"; then echo "rate_limited"
    elif grep -qiE "$BUDGET_RE" <<<"$tail_txt"; then echo "budget"
    else echo "unknown"
    fi
}

# notify_engine_unreachable — scoutctl could not run, so nothing can report run
# health. Raise a local desktop alert, at most once per interval. Same osascript /
# notify-send block as claude-with-retry.sh's notify_auth_failure. The marker is
# written only when a notification went out, so a host with no notifier retries.
notify_engine_unreachable() {
    local now last=0 sent=0
    local title="{{INSTANCE_NAME}} engine is broken"
    local body="scoutctl could not run, so {{INSTANCE_NAME}} cannot report run health. Reinstall: curl -fsSL https://raw.githubusercontent.com/Raven-Scout/Scout/main/install.sh | bash, or open Scout.app."
    now="$(date +%s)"
    if [ -f "$ENGINE_ALERT_MARKER" ]; then
        last="$(cat "$ENGINE_ALERT_MARKER" 2>/dev/null || true)"
        case "$last" in ''|*[!0-9]*) last=0 ;; esac
    fi
    # 10#: a value with a leading zero is decimal, not (invalid) octal.
    if [ $(( 10#$now - 10#$last )) -lt $(( 10#$ENGINE_ALERT_INTERVAL_S )) ]; then
        return 0
    fi
    if command -v osascript >/dev/null 2>&1; then
        # Title and body go in as argv, never into the AppleScript source.
        printf '%s\n' 'on run argv' \
            '    display notification (item 2 of argv) with title (item 1 of argv) sound name "Basso"' \
            'end run' \
            | osascript - "$title" "$body" >/dev/null 2>&1 && sent=1
    elif command -v notify-send >/dev/null 2>&1; then
        # cron runs without the desktop session's bus address; point at the user bus when there is one.
        [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "/run/user/$(id -u)/bus" ] && DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus" && export DBUS_SESSION_BUS_ADDRESS
        notify-send --urgency=critical "$title" "$body" >/dev/null 2>&1 && sent=1
    fi
    if [ "$sent" -eq 1 ]; then
        echo "$now" > "$ENGINE_ALERT_MARKER" 2>/dev/null || true
    fi
    return 0
}

# measure_commits <started_epoch> <finished_epoch> — print "<count> <newest>"
# for the commits in [started, finished], or nothing when it can't be measured.
# The bound is checked first: git's approxidate never errors, and an unparseable
# --since or one below ~1e9 silently means "now", which would count 0 commits
# with a clean exit and repeat #237's false "produced nothing" one layer down.
measure_commits() {
    local started="$1" finished="$2" shas count
    case "$started" in ''|*[!0-9]*) return 0 ;; esac
    [ "$started" -gt 1000000000 ] && [ "$started" -le "$finished" ] || return 0
    command -v git >/dev/null 2>&1 || return 0
    git -C "$SCOUT_DIR" rev-parse --verify --quiet HEAD >/dev/null 2>&1 || return 0
    shas="$(git -C "$SCOUT_DIR" log --since="@$started" --until="@$finished" --format=%h 2>/dev/null)" || return 0
    if [ -z "$shas" ]; then
        echo "0 -"
        return 0
    fi
    count="$(printf '%s\n' "$shas" | wc -l | tr -d ' ')"
    echo "$count $(printf '%s\n' "$shas" | head -n 1)"
}

# What started this run: the tick (it sets SCOUT_FORCE_MODE), the heartbeat
# (SCOUT_TRIGGER=heartbeat), or a person.
run_trigger() {
    case "${SCOUT_TRIGGER:-}" in
        schedule|heartbeat|manual) echo "$SCOUT_TRIGGER" ;;
        *) if [ -n "${SCOUT_FORCE_MODE:-}" ]; then echo schedule; else echo manual; fi ;;
    esac
}

cmd_record() {
    local mode="${1:-unknown}" code="${2:-0}" started="${3:-0}" log="${4:-}" outcome="${5:-}"
    local finished duration klass resets_at="" commits="" newest=""
    case "$code" in ''|*[!0-9]*) code=1 ;; esac
    local lease_class=""
    case "$outcome" in
        skipped_lock|skipped_budget|skipped_redundant) ;;
        lease_held|lease_unavailable) lease_class="$outcome"; outcome="skipped_lease"; code=0 ;;
        *) if [ "$code" -eq 0 ]; then outcome="ok"; else outcome="failed"; fi ;;
    esac
    case "$started" in ''|*[!0-9]*) started=0 ;; esac
    finished="$(date +%s)"
    duration=$(( finished - started ))
    [ "$duration" -lt 0 ] && duration=0
    klass="$(classify_failure "$log" "$code")"
    [ -n "$lease_class" ] && klass="$lease_class"
    # A usage limit that names its reset ("… limit · resets 2:10pm (Europe/Prague)")
    # lifts on its own; record when, so run health can say when Scout resumes (#407).
    # Optional: no engine, or no time it can read, leaves resets_at out of the row.
    if [ "$klass" = "rate_limited" ] && [ -n "$SCOUTCTL" ] && [ -x "$SCOUTCTL" ]; then
        resets_at="$("$SCOUTCTL" budget resets-at "$log" 2>/dev/null || true)"
        case "$resets_at" in ''|*[!0-9]*) resets_at="" ;; esac
    fi

    read -r commits newest <<<"$(measure_commits "$started" "$finished")" || true
    [ "$newest" = "-" ] && newest=""

    mkdir -p "$LOG_DIR"
    python3 - "$LEDGER" "$mode" "$code" "$started" "$finished" "$duration" "$klass" "$log" "$outcome" "$resets_at" \
        "$commits" "$newest" "$(run_trigger)" <<'PY' || true
import json, os, re, sys
(ledger, mode, code, started, finished, duration, klass, log, outcome, resets_at,
 commits, newest, trigger) = sys.argv[1:14]
row = {
    "slot": os.environ.get("SCOUT_FORCE_MODE") or mode,
    "mode": mode,
    "started_at": int(started),
    "finished_at": int(finished),
    "duration_s": int(duration),
    "exit_code": int(code),
    "failure_class": klass,
    "outcome": outcome,
    "log": os.path.basename(log) if log else None,
    "trigger": trigger,
    "commits_in_window": int(commits) if commits else None,
    "newest_commit": newest or None,
}
runner = os.environ.get("SCOUT_RUNNER_KIND")
if runner in ("scout", "dreaming", "research"):
    row["runner"] = runner
if resets_at:
    row["resets_at"] = int(resets_at)
# The model the runner passed to claude (scoutctl model resolve), so health and
# eval can attribute a run's cost; left out for rows from older runners.
model = os.environ.get("SCOUT_MODEL", "").strip().lower()
if re.fullmatch(r"[a-z0-9][a-z0-9.\-]*", model):
    row["model"] = model
with open(ledger, "a", encoding="utf-8") as fh:
    fh.write(json.dumps(row) + "\n")
PY

    # Every run, success included, so a recovery is noticed. The output lands
    # next to the run's own log when there is one.
    local notify_log="$LOG_DIR/health-notify.log"
    [ -n "$log" ] && [ -f "$log" ] && notify_log="$log"
    if [ -n "$SCOUTCTL" ] && [ -x "$SCOUTCTL" ] \
        && "$SCOUTCTL" health notify --quiet >>"$notify_log" 2>&1; then
        rm -f "$ENGINE_ALERT_MARKER" 2>/dev/null || true
    else
        notify_engine_unreachable
    fi
    return 0
}

# clear-stale-locks — remove .git lock files left behind by a run that died
# mid-commit, which otherwise block every later commit. Only locks older than
# two hours are removed; a younger one may belong to a live run.
cmd_clear_stale_locks() {
    local lock mtime now cleared=0
    now="$(date +%s)"
    for lock in "$SCOUT_DIR/.git/index.lock" "$SCOUT_DIR/.git/HEAD.lock"; do
        [ -f "$lock" ] || continue
        # GNU stat first (it errors on BSD), BSD stat second.
        mtime="$(stat -c %Y "$lock" 2>/dev/null || stat -f %m "$lock" 2>/dev/null || echo "")"
        case "$mtime" in ''|*[!0-9]*) continue ;; esac
        if [ $(( now - mtime )) -gt 7200 ]; then
            rm -f "$lock" && cleared=$((cleared + 1))
            echo "cleared stale lock: $lock" >&2
        else
            echo "lock present but recent, leaving alone: $lock" >&2
        fi
    done
    [ "$cleared" -gt 0 ] && echo "$cleared stale lock(s) cleared"
    return 0
}

# Dispatch only when executed, not when sourced, so the classifier can be
# exercised on its own.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    case "${1:-}" in
        record)            shift; cmd_record "$@" ;;
        clear-stale-locks) cmd_clear_stale_locks ;;
        *) echo "usage: $0 {record <mode> <exit_code> <started_epoch> <log_file> [<outcome>]|clear-stale-locks}" >&2
           exit 64 ;;
    esac
fi
