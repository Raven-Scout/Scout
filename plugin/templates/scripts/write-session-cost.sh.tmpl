#!/bin/bash
# Write session cost entry to the usage tracker
# Called by {{INSTANCE_NAME}} sessions as their final action before exit
#
# Usage: write-session-cost.sh <type> <budget_cap> <budget_spent> [exit_code] [source]
# Example: write-session-cost.sh dreaming 10 7.42 0 session
#
# source: "session" (actual Claude-reported cost) or "runner" (fallback from shell script).
# Runner entries exist only so crashed sessions still leave a row, and get $0 as the
# spent amount. budget_check.decide() sums budget_spent over EVERY row in its window,
# whatever the source, so a session that writes its row twice is counted twice.

set -euo pipefail

TRACKER_FILE="{{SCOUT_DIR}}/.scout-logs/usage-tracker.jsonl"
mkdir -p "$(dirname "$TRACKER_FILE")"

TYPE="${1:-unknown}"
BUDGET_CAP_RAW="${2:-0}"
BUDGET_SPENT_RAW="${3:-0}"
EXIT_CODE="${4:-0}"
SOURCE="${5:-session}"
TIMESTAMP=$(TZ=UTC date '+%Y-%m-%dT%H:%M:%SZ')
# Localized timestamp — resolve the configured timezone via scout-tz.sh.
# Double fallback to America/New_York: scout-tz.sh itself falls back to the default
# on bad/missing config, and the `|| echo` guards a missing/unreadable resolver — so
# this can never go timezone-blind (preserves Pattern #29: always one explicit TZ,
# never bare `date`).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCOUT_TZ="$("$SCRIPT_DIR/scout-tz.sh" 2>/dev/null || echo America/New_York)"
TIMESTAMP_LOCAL=$(TZ="$SCOUT_TZ" date '+%Y-%m-%d %H:%M %Z')

# Numeric validation — falls back to 0 if the arg isn't a plain number.
# Prevents malformed JSON when the caller accidentally passes a summary string,
# a timestamp, or the literal word "session" (arg-order confusion observed in practice).
is_numeric() {
    [[ "$1" =~ ^-?[0-9]+(\.[0-9]+)?$ ]]
}

if is_numeric "$BUDGET_CAP_RAW"; then
    BUDGET_CAP="$BUDGET_CAP_RAW"
else
    echo "write-session-cost.sh: non-numeric budget_cap '$BUDGET_CAP_RAW' — falling back to 0" >&2
    BUDGET_CAP=0
fi

if is_numeric "$BUDGET_SPENT_RAW"; then
    BUDGET_SPENT="$BUDGET_SPENT_RAW"
else
    echo "write-session-cost.sh: non-numeric budget_spent '$BUDGET_SPENT_RAW' — falling back to 0" >&2
    BUDGET_SPENT=0
fi

if ! is_numeric "$EXIT_CODE"; then
    EXIT_CODE=0
fi

# The model the runner chose (it exports SCOUT_MODEL into the session too), so
# cost can be attributed per model. Only a plain model name is written; anything
# else would break the JSON line, so it is left out.
MODEL_FIELD=""
if [[ "${SCOUT_MODEL:-}" =~ ^[a-z0-9][a-z0-9.-]*$ ]]; then
    MODEL_FIELD=",\"model\":\"$SCOUT_MODEL\""
fi

# Session identity. A session calls this from its own Bash tool, where Claude Code
# exports CLAUDE_CODE_SESSION_ID. Two rows with the SAME id are one run writing twice
# (e.g. a run that re-ran this script to check it worked), which would otherwise have to
# be inferred from timestamps. Runner rows have no such variable and omit the key, and
# budget_check.decide() reads rows with .get(), so the extra key is inert to it.
SESSION_FIELD=""
if [[ "${CLAUDE_CODE_SESSION_ID:-}" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
    SESSION_FIELD=",\"session_id\":\"$CLAUDE_CODE_SESSION_ID\""
fi

echo "{\"ts\":\"$TIMESTAMP\",\"ts_local\":\"$TIMESTAMP_LOCAL\",\"type\":\"$TYPE\",\"budget_cap\":$BUDGET_CAP,\"budget_spent\":$BUDGET_SPENT,\"exit_code\":$EXIT_CODE,\"source\":\"$SOURCE\"$MODEL_FIELD$SESSION_FIELD}" >> "$TRACKER_FILE"
