#!/bin/bash
# {{INSTANCE_NAME}} Research runner — invoked by heartbeat or manually for knowledge expansion
# Goes outward: web search, docs, APIs to enrich KB entities with real-world knowledge

set -euo pipefail

SCOUT_DIR="{{SCOUT_DIR}}"
# Exported so any consumer of scout-plugin's engine package resolves the vault.
export SCOUT_DATA_DIR="$SCOUT_DIR"
LOG_DIR="$SCOUT_DIR/.scout-logs"
CLAUDE_BIN="{{CLAUDE_BIN}}"
SCOUTCTL_BIN="{{SCOUTCTL_BIN}}"
TIMESTAMP=$(date +%Y-%m-%d_%H-%M)
LOG_FILE="$LOG_DIR/research-$TIMESTAMP.log"
LOCK_FILE="$LOG_DIR/.scout-session.lock"

# Ensure log directory exists
mkdir -p "$LOG_DIR"

# Pin this run's timezone for every child — the shell helpers, the engine's
# Python hooks, the session itself — so they all date the run alike, even if
# the computer's zone changes mid-run. scripts/scout-tz.sh resolves it once,
# here on the host: scout-config.yaml's optional override, else the host's own
# zone. A warning (an override that names no real zone) goes to this run's log.
RUN_TZ="$("$SCOUT_DIR/scripts/scout-tz.sh" 2>>"$LOG_FILE" || true)"
if [ -n "$RUN_TZ" ]; then
    export SCOUT_USER_TIMEZONE="$RUN_TZ"
fi

# Mode is set by the dispatcher (SCOUT_FORCE_MODE). For manual invocations
# without SCOUT_FORCE_MODE set, default to "research-manual".
MODE="${SCOUT_FORCE_MODE:-research-manual}"
RUNNER_KIND=research

# Concurrency guard — only one {{INSTANCE_NAME}} session at a time. The lock
# protocol (#331), the wait for a busy lock and the redundant-run check (#218)
# live in scripts/scout-lock.sh, shared by all three runners. It is rendered
# with them, so a vault without it is a broken install: fail loudly rather than
# run unlocked.
RUN_START=$(date +%s)
export SCOUT_RUNNER_KIND="$RUNNER_KIND"
LOCK_LIB="$SCOUT_DIR/scripts/scout-lock.sh"
if [ ! -r "$LOCK_LIB" ]; then
    echo "=== $LOCK_LIB is missing — not running without the session lock. Run /scout-update to restore it. ===" >> "$LOG_FILE"
    echo "{{INSTANCE_NAME}} $RUNNER_KIND run FAILED: scripts/scout-lock.sh missing at $(date)" >> "$LOG_DIR/failures.log"
    if [ -x "$SCOUT_DIR/scripts/run-outcome.sh" ]; then
        "$SCOUT_DIR/scripts/run-outcome.sh" record "$MODE" 1 "$RUN_START" "$LOG_FILE" >> "$LOG_FILE" 2>&1 || true
    fi
    exit 1
fi
# shellcheck source=scripts/scout-lock.sh
. "$LOCK_LIB"
if ! scout_lock_acquire; then
    scout_record_skip skipped_lock
    exit 0
fi
if ! scout_redundant_wait_guard; then
    scout_record_skip skipped_redundant
    exit 0
fi

PROMPT="You are {{INSTANCE_NAME}} running in RESEARCH mode — the knowledge expansion session. Your working directory is {{SCOUT_DIR}}.

Step 1: Read {{SCOUT_DIR}}/RESEARCH.md in full.
Step 2: Execute Phase 1 (Select Research Targets) — check the \`research-queue/\` folder first, then score entities.
Step 3: Execute Phase 2 (Deep Research) — web search, docs, APIs for each target.
Step 4: Execute Phase 3 (Knowledge Integration) — update entity files, extend ontology.
Step 5: Commit results to git.
Step 6: Send a brief Slack DM to {{USER_NAME}} (Slack ID: {{USER_SLACK_ID}}) summarizing what was researched and key findings.

Important:
- Use 'gh' CLI for all GitHub operations (not GitHub MCP).
- The knowledge base is in {{SCOUT_DIR}}/knowledge-base/.
- Always use [[wikilinks]] when referencing KB files.
- Commit with message format: research [HH:MM]: <summary>
- Mark single-source web claims with [single-source].
- Your output should focus on what you found and changed, not infrastructure steps."

echo "=== {{INSTANCE_NAME}} Research run starting at $(date) ===" >> "$LOG_FILE"

# Daily-file completeness invariant — if today's action-items file doesn't
# exist yet, materialize it verbatim from the most recent daily file so no
# session (or app surface) ever sees a missing/stub list. No-op when present.
MATERIALIZE="$SCOUT_DIR/scripts/materialize-daily-file.sh"
if [ -x "$MATERIALIZE" ]; then
    "$MATERIALIZE" >> "$LOG_FILE" 2>&1 || true
fi

# Budget check — skip if we're over the spending threshold
BUDGET_CHECK="$SCOUT_DIR/scripts/budget-check.sh"
if [ -x "$BUDGET_CHECK" ]; then
    if ! "$BUDGET_CHECK" --verbose >> "$LOG_FILE" 2>&1; then
        echo "=== Budget check: skipping this run ===" >> "$LOG_FILE"
        scout_record_skip skipped_budget
        exit 0
    fi
fi

# Exported as SCOUT_MODE so the plugin's Stop hooks (session-tool-log,
# session-tokens — see hooks/hooks.json) see it inside the claude child
# process. When it is unset, session-tool-log deliberately writes nothing (so
# interactive sessions stay silent) and session-tokens labels the run `manual`;
# without this export every scheduled run looks interactive and no connector
# telemetry is ever written (#192, #121).
export SCOUT_MODE="$MODE"

# The Claude model for this run: SCOUT_MODEL, else the slot's `model:` in
# .scout-state/schedule.yaml, else scout-config's models.default, else opus —
# resolved by the engine (scout/models.py). A resolver failure never blocks the
# run: it goes ahead on opus, the default, and the reason lands in this log.
SCOUT_MODEL="$("$SCOUTCTL_BIN" model resolve --slot "$MODE" 2>>"$LOG_FILE" || true)"
if [ -z "$SCOUT_MODEL" ]; then
    echo "=== model resolve failed — running on opus ===" >> "$LOG_FILE"
    SCOUT_MODEL=opus
fi
# Exported so the run-outcome and session-cost rows can record it.
export SCOUT_MODEL
echo "=== model: $SCOUT_MODEL ===" >> "$LOG_FILE"

START_TIME=$(date +%s)

# Run Claude in print mode through the retry wrapper — capture exit code without triggering set -e.
# Wrapper handles log redirection and retries on transient API errors (socket close,
# ECONNRESET, ConnectionRefused, Stream idle timeout, 529 Overloaded). See scripts/claude-with-retry.sh.
EXIT_CODE=0
cd "$SCOUT_DIR" && "$SCOUT_DIR/scripts/claude-with-retry.sh" \
    "$LOG_FILE" \
    "$CLAUDE_BIN" \
    --permission-mode auto \
    --model "$SCOUT_MODEL" \
    --max-budget-usd {{MAX_BUDGET}} \
    --name "{{INSTANCE_NAME_LOWER}}-${MODE}-$(date +%Y%m%d-%H%M)" \
    -p "$PROMPT" \
    || EXIT_CODE=$?
END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

echo "=== {{INSTANCE_NAME}} Research run finished at $(date) (exit code: $EXIT_CODE, duration: ${DURATION}s) ===" >> "$LOG_FILE"

# If the run failed, log it and check for rate limiting
if [ $EXIT_CODE -ne 0 ]; then
    echo "{{INSTANCE_NAME}} Research run FAILED with exit code $EXIT_CODE at $(date)" >> "$LOG_DIR/failures.log"
    RATE_DETECT="$SCOUT_DIR/scripts/rate-limit-detect.sh"
    if [ -x "$RATE_DETECT" ]; then
        if "$RATE_DETECT" "$LOG_FILE" --write-tracker 2>/dev/null; then
            echo "Rate limit detected — logged to usage tracker" >> "$LOG_FILE"
        fi
    fi
fi

# Record how this run ended, out-of-band. This has to be a runner step, not a
# session step: the failure being watched for is a run that never reaches its
# phases (an expired login, a dead network), and nothing the session writes can
# report that. scripts/run-outcome.sh is an optional vault helper; a vault
# without it skips this step. Its errors go to the run log, so a broken helper
# (and with it the failure alerting) leaves a trace.
OUTCOME="$SCOUT_DIR/scripts/run-outcome.sh"
if [ -x "$OUTCOME" ]; then
    "$OUTCOME" record "$MODE" "$EXIT_CODE" "$START_TIME" "$LOG_FILE" >> "$LOG_FILE" 2>&1 || true
fi

# Regenerate the connector-health surface from the runner, for the same reason:
# a run that dies early has still logged its tool calls, but never refreshes
# knowledge-base/connector-health.md, which then goes stale while still looking
# current (showing alerts that later runs already resolved). The engine does the
# roll-up and says in this log when it had nothing to rewrite. Never fatal.
if [ -x "$SCOUTCTL_BIN" ]; then
    "$SCOUTCTL_BIN" connector-health-report >> "$LOG_FILE" 2>&1 || true
else
    echo "connector-health roll-up skipped: scoutctl not found at $SCOUTCTL_BIN" >> "$LOG_FILE"
fi

# Track session cost (skill self-reports actual cost from inside the session via the
# same script; this runner call is a fallback so failed/crashed runs still leave a row).
COST_TRACKER="$SCOUT_DIR/scripts/write-session-cost.sh"
if [ -x "$COST_TRACKER" ]; then
    "$COST_TRACKER" "research" {{MAX_BUDGET}} 0 "$EXIT_CODE" "runner" 2>/dev/null || true
fi
