#!/usr/bin/env bash
# scoutctl launcher — resolves the venv Python deterministically so
# hooks invoked from LaunchAgents (which don't inherit user PATH)
# still find the right interpreter.
#
# Probe order:
#   1. ${PLUGIN_ROOT}/.venv         — canonical location written by
#                                     scripts/install-venv.sh
#   2. ${PLUGIN_ROOT}/engine/.venv  — legacy / hand-built layout
#   2b. engine pointer              — ~/.local/state/scout/engine.json "python"
#                                     (matches engine_pointer.state_dir)
#   3. Sibling marketplaces/ tree   — recover when we're loaded from
#                                     Claude Code's cache/ copy but the
#                                     venv lives in marketplaces/ (at the
#                                     clone root for a legacy scout-plugin
#                                     clone, under plugin/ for a
#                                     Raven-Scout/Scout monorepo clone)
#   4. system python3               — last resort; expects scout-engine on
#                                     the global site-packages
#
# Executable is not enough: a venv outlives its editable source, so once the
# checkout moves (engine/ -> plugin/engine/) its python still passes `[ -x ]`
# but dies with `No module named scout.cli`. Each executable candidate is
# therefore probed (PROBE below) before we trust it, and a dead one falls
# through to the next.
#
# Per #81: once a candidate resolves, we cache it at
# ${PLUGIN_ROOT}/.scoutctl-py-cache so the next invocation skips the probe.
# Line 1 is the interpreter; the remaining lines are its stamp, meaning the
# files the probe resolved scout.cli through (the module and the installed
# dist's METADATA). The fast path re-checks the stamp with file tests only
# (a Python pre-check would add ~20-60 ms to every hook call). A cache that
# fails the check is deleted, and we fall through to the full probe. The cache
# lives inside the plugin so different plugin installs don't share state.
set -e

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
ENGINE_DIR="${DIR%/bin}"
PLUGIN_ROOT="${ENGINE_DIR%/engine}"

CACHE_FILE="${PLUGIN_ROOT}/.scoutctl-py-cache"

# Resolves scout.cli the way `-m` will, without running it, and prints the
# stamp. Exits non-zero when the interpreter can't find scout.cli. The dist-info
# is found with listdir, not importlib.metadata, which costs ~30 ms to import.
PROBE='import importlib.util, os, sys
print(importlib.util.find_spec("scout.cli").origin)
for d in map(os.path.abspath, sys.path):
    try:
        names = os.listdir(d)
    except OSError:
        continue
    for n in names:
        if n.startswith("scout_engine-") and n.endswith(".dist-info"):
            print(os.path.join(d, n, "METADATA"))'

# Fast path: the cached interpreter is executable and every stamped file is
# still there. A cache written before stamps existed has no stamp, so it gets
# one fresh probe.
if [ -r "$CACHE_FILE" ]; then
    CACHED_PY="" STAMPED=0 MISSING=0
    {
        IFS= read -r CACHED_PY || true
        while IFS= read -r STAMP || [ -n "$STAMP" ]; do
            STAMPED=1
            [ -f "$STAMP" ] || MISSING=1
        done
    } <"$CACHE_FILE"
    if [ -n "$CACHED_PY" ] && [ -x "$CACHED_PY" ] && [ "$STAMPED" = 1 ] && [ "$MISSING" = 0 ]; then
        exec "$CACHED_PY" -m scout.cli "$@"
    fi
    rm -f "$CACHE_FILE" 2>/dev/null || true
fi

candidates=(
    "${PLUGIN_ROOT}/.venv/bin/python"
    "${ENGINE_DIR}/.venv/bin/python"
)

# The engine pointer (~/.local/state/scout/engine.json, written by every
# `scoutctl bootstrap …` that installs jobs) names the venv that matches the
# installed engine.
# Consulted AFTER the in-tree venv so a dev checkout keeps edit-and-go, and
# BEFORE the marketplaces/ cross-jump so Claude Code's cache copy of an
# app-managed engine (whose venv lives outside the tree) resolves without
# guessing. Parsed with sed on purpose: this launcher has to work with only
# /bin/sh tools — finding Python is the whole point.
POINTER="$HOME/.local/state/scout/engine.json"
if [ -r "$POINTER" ]; then
    POINTER_PY="$(sed -n 's/^[[:space:]]*"python"[[:space:]]*:[[:space:]]*"\([^"]*\)".*$/\1/p' "$POINTER" | head -n 1)"
    if [ -n "$POINTER_PY" ]; then
        candidates+=("$POINTER_PY")
    fi
fi

# Claude Code installs a marketplace plugin twice: a frozen copy under
# plugins/cache/<marketplace>/<plugin>/<version>/ (used at runtime) and a
# clone under plugins/marketplaces/<marketplace>/ (where install-venv.sh
# typically lands). Cross-jump when the launcher fires from cache/. A legacy
# scout-plugin clone has the plugin at the clone root; a Raven-Scout/Scout
# monorepo clone has it under plugin/ (the marketplace's "source": "./plugin").
if [[ "$PLUGIN_ROOT" == */plugins/cache/* ]]; then
    PLUGINS_DIR="${PLUGIN_ROOT%%/cache/*}"
    REST="${PLUGIN_ROOT#*/cache/}"
    MARKETPLACE_NAME="${REST%%/*}"
    MARKETPLACE_CLONE="${PLUGINS_DIR}/marketplaces/${MARKETPLACE_NAME}"
    candidates+=(
        "${MARKETPLACE_CLONE}/.venv/bin/python"
        "${MARKETPLACE_CLONE}/engine/.venv/bin/python"
        "${MARKETPLACE_CLONE}/plugin/.venv/bin/python"
        "${MARKETPLACE_CLONE}/plugin/engine/.venv/bin/python"
    )
fi

for VENV_PY in "${candidates[@]}"; do
    # The probe gets /dev/null as stdin, which leaves the hook payload for the real call.
    if [ -x "$VENV_PY" ] && STAMP_LINES="$("$VENV_PY" -c "$PROBE" </dev/null 2>/dev/null)"; then
        # Best-effort write to the cache so the next call skips the probe.
        # Failures (read-only plugin root in Claude Code's cache copy, no
        # write perms, etc.) are silently ignored.
        printf '%s\n%s\n' "$VENV_PY" "$STAMP_LINES" >"$CACHE_FILE" 2>/dev/null || true
        exec "$VENV_PY" -m scout.cli "$@"
    fi
done

exec python3 -m scout.cli "$@"
