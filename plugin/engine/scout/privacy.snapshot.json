{
  "engine_version": "0.18.23",
  "policy": {
    "federation": {
      "enabled": false
    },
    "federation_ceilings": [
      {
        "ceiling": "org",
        "glob": "knowledge-base/topics/**"
      },
      {
        "ceiling": "org",
        "glob": "knowledge-base/projects/**"
      },
      {
        "ceiling": "org",
        "glob": "knowledge-base/ontology/entities/**"
      },
      {
        "ceiling": "org",
        "glob": "knowledge-base/research-queue/**"
      },
      {
        "ceiling": "people",
        "glob": "knowledge-base/sources/**",
        "kinds": [
          "meeting",
          "thread"
        ]
      },
      {
        "ceiling": "org",
        "glob": "knowledge-base/organizations/**"
      },
      {
        "ceiling": "org",
        "glob": "knowledge-base/work/topics/**"
      },
      {
        "ceiling": "org",
        "glob": "knowledge-base/work/projects/**"
      },
      {
        "ceiling": "org",
        "glob": "knowledge-base/work/organizations/**"
      },
      {
        "ceiling": "people",
        "glob": "knowledge-base/work/sources/**",
        "kinds": [
          "meeting",
          "thread"
        ]
      }
    ],
    "federation_ceilings_overlay": [],
    "federation_defaults": [],
    "local_only": {
      "always": [
        ".scout-logs/**",
        ".scout-cache/**",
        ".claude/**",
        ".venv/**",
        ".obsidian/**",
        ".pytest_cache/**",
        ".mcp.json",
        ".env*",
        ".scout-state/**",
        ".scout-inbox/agents/**"
      ],
      "default": [
        ".scout-inbox/agents/**"
      ],
      "sync_allow": [
        ".scout-state/schedule.yaml",
        ".scout-state/id-map.json",
        ".scout-state/privacy-policy.json"
      ]
    },
    "shared_files": [
      "drafts/**"
    ],
    "surfaces": {
      "owner_only": [
        "agnes_owner_conversation",
        "agnes_personal_memory",
        "app",
        "telegram_private_chat",
        "vault",
        "vault_sync"
      ],
      "shared": [
        "agnes_memory_promotion",
        "agnes_shared",
        "connector_query",
        "connector_write",
        "peer_agent",
        "public_repo",
        "slack",
        "telegram_group_chat",
        "web_query"
      ]
    },
    "visibility_defaults": [
      {
        "glob": "knowledge-base/personal/**",
        "visibility": "private"
      },
      {
        "glob": ".scout-inbox/**",
        "visibility": "private"
      }
    ],
    "visibility_forced_private": [
      "knowledge-base/lab/*/experiments/*/**"
    ]
  },
  "schema_version": 1
}
